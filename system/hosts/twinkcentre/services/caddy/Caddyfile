:80 {
	respond <<EOF
		WireGuard reverse tunnel established.
		Remote IP: {http.request.remote.host}
		Forwarded Client IP: {http.request.header.X-Forwarded-For}
		EOF
}

:8080 {
	reverse_proxy whoami-public:80

	# respond "Hello, pubnet!"
}

:8081 {
	@whoami host whoami.internal
	handle @whoami {
		reverse_proxy whoami-internal:80
	}

	# respond "Hello, intranet!"
}
